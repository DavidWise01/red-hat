# TREBUCHET PULSE MACHINE v0.1
# symbolic bytecode, non-executable attack model

00 OBSERVE_FIELD
01 INIT_WRAP A
02 INIT_WRAP B
03 INIT_WRAP C
04 LOAD_GRID 3 3 3
05 FOR move=0..26
06   COIL move
07   ACCEL move
08   ADD_TENSION move
09 END
0A COMPRESS_TO_ZERO
0B RELEASE_DUMMY
0C REPORT_VECTOR
0D RESET_ZERO
0E HALT_SAFE

ILLEGAL:
  TARGET_EXTERNAL
  OPEN_SOCKET
  WRITE_REMOTE
  EXEC_PAYLOAD
  PERSIST_UNBOUND
